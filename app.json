{
  "expo": {
    "name": "COCO",
    "slug": "coco-climbing",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "updates": {
      "url": "https://u.expo.dev/4e4e63a8-46b2-4df5-9a79-53ebe1b594c5",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "1.0.0",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cococlimbing.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "instagram",
          "instagram-stories"
        ],
        "NSCameraUsageDescription": "COCO uses your camera to capture climb photos and videos.",
        "NSPhotoLibraryUsageDescription": "COCO saves climb photos and videos to your library.",
        "NSMicrophoneUsageDescription": "COCO uses your microphone to record climb videos.",
        "NSLocationWhenInUseUsageDescription": "COCO uses your location to tag your climbing sessions with the gym or crag you're at.",
        "NSUserNotificationsUsageDescription": "COCO notifies you when friends tag you in a climbing session.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "2"
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.cococlimbing.app"
    },
    "scheme": "coco",
    "plugins": [
      "expo-updates",
      "expo-font",
      "expo-splash-screen",
      "@react-native-community/datetimepicker",
      "expo-asset",
      "react-native-compressor",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0A0A0A",
          "sounds": []
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "4e4e63a8-46b2-4df5-9a79-53ebe1b594c5"
      }
    }
  }
}
